# Copy this file to ".env" and fill in your key.
# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for Q&A, quiz, summary and learning paths.
# (gemini-1.5-pro from the original design has been retired by Google.)
GEMINI_MODEL=gemini-2.5-flash

# Explain module backend: auto | local | gemini
#   auto   -> use local LaMini-Flan-T5 if transformers is installed, else Gemini
#   local  -> local model only (falls back to Gemini if it fails to load)
#   gemini -> always Gemini
EXPLAIN_BACKEND=auto
LOCAL_MODEL_NAME=MBZUAI/LaMini-Flan-T5-783M
